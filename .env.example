# ============================================================
# Maybech — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- OKX API ----
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# "0" for live, "1" for demo trading
OKX_FLAG=1

# ---- Trading ----
# Comma-separated trading pairs, e.g. BTC-USDT,ETH-USDT,SOL-USDT
TRADING_PAIRS=BTC-USDT,ETH-USDT
# Candlestick interval: 1m, 5m, 15m, 1H, 4H, 1D
CANDLE_INTERVAL=15m
# Max percentage of account balance per trade (0.0 ~ 1.0)
MAX_POSITION_RATIO=0.1

# ---- Risk Management (bear-market bias) ----
# Stop-loss % for long positions  (tighter in bear market)
STOP_LOSS_LONG_PCT=0.02
# Stop-loss % for short positions (wider in bear market)
STOP_LOSS_SHORT_PCT=0.04
# Take-profit % for long positions
TAKE_PROFIT_LONG_PCT=0.03
# Take-profit % for short positions
TAKE_PROFIT_SHORT_PCT=0.05

# ---- Backtesting ----
# Minimum win-rate to auto-approve a strategy (0.0 ~ 1.0)
BACKTEST_MIN_WIN_RATE=0.55
# Minimum return-rate to auto-approve a strategy
BACKTEST_MIN_RETURN_RATE=0.10
# Lookback period in days for backtesting
BACKTEST_LOOKBACK_DAYS=30

# ---- Notifications ----
# LINE Bot (optional — leave blank to disable)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=

# Email (optional — leave blank to disable)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=inpire.mg09@nycu.edu.tw
EMAIL_PASSWORD=
EMAIL_RECEIVER=inpire.mg09@nycu.edu.tw

# ---- Logging ----
LOG_LEVEL=INFO
