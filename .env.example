# ============================================================
# Maybech environment variables
# Copy this file to .env and fill local values. Never commit .env.
# Defaults favor local Simulation. Select Demo explicitly at runtime.
# ============================================================

# ---- OKX API ----
# Production credentials. Selected only when OKX_FLAG=0.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Demo credentials. Selected only when OKX_FLAG=1.
DEMO_OKX_API_KEY=
DEMO_OKX_API_SECRET=
DEMO_OKX_PASSPHRASE=

# OKX environment selector: "1" = demo trading, "0" = production trading.
# Keep demo active until the complete demo execution lifecycle is verified.
OKX_FLAG=1

# ---- SQLite persistence ----
# All backend stores share this file. Use an absolute path in deployed setups.
MAYBECH_DB_PATH=data/trades.db

# Optional local-only OKX-shaped candle replay JSON used by Simulation.
# Leave blank to report market evidence unavailable without contacting OKX.
MAYBECH_SIMULATION_CANDLES=

# Browser origins allowed to call FastAPI directly. Keep this local-only until
# API authentication and TLS are implemented.
MAYBECH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required with `src.runtime api --allow-remote` and a non-loopback host.
# Use a long random value and terminate TLS at a trusted reverse proxy.
MAYBECH_API_TOKEN=

# ---- Trading safety ----
# Must stay "0" unless explicitly starting Demo or Live Armed. The runtime still
# refuses to arm until credentials, account/position mode, enabled strategies,
# active position instruments, and OKX instrument constraints pass preflight.
MAYBECH_ARM_ORDERS=0

# Strategy instruments, signals, close rules, and per-instrument contract
# sizes are persisted in SQLite and managed through the strategy API.

# ---- Notifications ----
# LINE Bot is optional. Leave blank to disable LINE push setup.
LINE_CHANNEL_ACCESS_TOKEN=
# Also verifies inbound webhook signatures for the optional LINE command bot
# (POST /notifications/line/webhook); see docs/deployment.md.
LINE_CHANNEL_SECRET=
# Only this LINE user id may run bot commands; every other sender is rejected.
LINE_USER_ID=
# Optional stable ngrok domain used by start_backend.ps1.
MAYBECH_NGROK_DOMAIN=
# Suppress repeated equivalent lifecycle messages during this window.
NOTIFICATION_COOLDOWN_SECONDS=300

# Email alerts are optional. Leave sender/password/receiver blank to disable.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# ---- Runtime logging ----
LOG_LEVEL=INFO

# ---- Frontend ----
# Used by the Next.js dashboard. Defaults to this URL when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
