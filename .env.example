# ============================================================
# Maybech environment variables
# Copy this file to .env and fill local values. Never commit .env.
# Defaults favor local dry-run/demo operation.
# ============================================================

# ---- OKX API ----
# Required for account snapshots, private OKX integration tests, and live/demo
# order execution. Leave blank for UI/API development with mocked or unavailable
# private account data.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# OKX SDK flag: "1" = demo trading, "0" = live trading.
OKX_FLAG=1

# ---- SQLite persistence ----
# All backend stores share this file. Use an absolute path in deployed setups.
MAYBECH_DB_PATH=data/trades.db

# ---- Trading safety ----
# Must stay "0" unless you intentionally want OKXClient.place_limit_order() to
# allow real order placement after code-level confirm=True.
MAYBECH_ARM_ORDERS=0

# ---- Trading universe ----
# Comma-separated OKX instruments. Swap instruments should include -SWAP.
TRADING_PAIRS=BTC-USDT-SWAP,ETH-USDT-SWAP
# Candlestick interval, for example: 1m, 5m, 15m, 1H, 4H, 1D.
CANDLE_INTERVAL=1m
# Current executor uses this fixed quantity for ETH-sized orders.
TRADE_QUANTITY_ETH=0.1

# ---- Momentum strategy ----
MOMENTUM_K_LONG=10.0
MOMENTUM_K_SHORT=5.0
PRICE_GAP_THRESHOLD=3.0

# ---- Risk management ----
STOP_LOSS_LONG_PCT=0.02
STOP_LOSS_SHORT_PCT=0.04
TAKE_PROFIT_LONG_PCT=0.03
TAKE_PROFIT_SHORT_PCT=0.05

# ---- Notifications ----
# LINE Bot is optional. Leave blank to disable LINE push setup.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=
# "1" enables the notification service config, "0" disables it.
NOTIFICATOR_ENABLED=1

# Email alerts are optional. Leave sender/password/receiver blank to disable.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# ---- Runtime logging ----
LOG_LEVEL=INFO

# ---- Frontend ----
# Used by the Next.js dashboard. Defaults to this URL when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
